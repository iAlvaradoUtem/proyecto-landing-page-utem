---
const slides = [
  "/hero-bg.jpg",
  "/hero-bg2.jpg",
  "/hero-bg3.jpg"
];
---

<section id="hero" class="relative h-screen min-h-[600px] flex items-center justify-center overflow-hidden">
    
    <!-- CARRUSEL -->
    <div class="absolute inset-0 z-0 bg-slate-900">
        {slides.map((slide, index) => (
            <div 
                class={`absolute inset-0 w-full h-full transition-opacity duration-1000 ease-in-out hero-slide ${index === 0 ? 'opacity-100' : 'opacity-0'}`}
                data-index={index}
            >
                <img 
                    src={slide} 
                    alt={`Fondo UTEM ${index + 1}`} 
                    class="w-full h-full object-cover"
                />
            </div>
        ))}
        <div class="absolute inset-0 bg-utem-blue/70 mix-blend-multiply"></div>
    </div>

    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center text-white">
        
        <!-- Etiquetas de Prestigio -->
        <div class="flex justify-center gap-3 mb-6 flex-wrap">
            <span class="inline-block py-1 px-3 border border-utem-green text-utem-green bg-utem-blue/40 backdrop-blur-md uppercase tracking-widest text-xs font-bold rounded-sm animate-fade-in-up">
                Acreditada & Estatal
            </span>
            <span class="inline-block py-1 px-3 border border-white/30 text-white bg-white/10 backdrop-blur-md uppercase tracking-widest text-xs font-bold rounded-sm animate-fade-in-up delay-100">
                Admisión 2026
            </span>
        </div>

        <!-- Headline -->
        <h1 class="text-4xl md:text-6xl lg:text-7xl font-serif font-bold mb-6 leading-tight drop-shadow-2xl animate-fade-in-up delay-200">
            Ingeniería en Informática.<br/>
            <span class="text-3xl md:text-5xl lg:text-6xl text-transparent bg-clip-text bg-gradient-to-r from-utem-green to-teal-400 italic pr-3 pb-1 inline-block">
                Diseña el Futuro.
            </span>
        </h1>
        
        <!-- Propuesta de Valor -->
        <p class="mt-4 text-lg md:text-xl text-slate-100 max-w-3xl mx-auto font-light mb-10 leading-relaxed drop-shadow-md animate-fade-in-up delay-300">
            Únete a la carrera con <strong>93.3% de empleabilidad</strong>. Fórmate como un Ingeniero capaz de liderar proyectos tecnológicos complejos con un sello único de responsabilidad social.
        </p>
        
        <div class="flex flex-col sm:flex-row gap-4 justify-center items-center animate-fade-in-up delay-500">
            <a href="#contact" class="bg-utem-green hover:bg-green-600 text-white px-8 py-4 text-lg font-bold transition-all uppercase tracking-wide shadow-[0_0_20px_rgba(0,133,74,0.6)] hover:shadow-[0_0_30px_rgba(0,133,74,0.8)] rounded-sm w-full sm:w-auto transform hover:-translate-y-1">
                ¡Postula Ahora!
            </a>
            
            <a href="https://conocetucarrera.utem.cl/ingenieria-en-informatica/" target="_blank" class="border border-white hover:bg-white hover:text-utem-blue text-white px-8 py-4 text-lg font-bold transition-all uppercase tracking-wide rounded-sm backdrop-blur-sm hover:backdrop-blur-none w-full sm:w-auto">
                Ver Malla Curricular
            </a>

            <a href="https://conocetucarrera.utem.cl/wp-content/uploads/2024/11/INGENIERIA_EN_INFORMATICA_UTEM.pdf" target="_blank" class="border border-white hover:bg-white hover:text-utem-blue text-white px-8 py-4 text-lg font-bold transition-all uppercase tracking-wide rounded-sm backdrop-blur-sm hover:backdrop-blur-none w-full sm:w-auto flex items-center justify-center gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
                </svg>
                Descargar Folleto
            </a>
        </div>
    </div>
</section>

<script>
    const slides = document.querySelectorAll('.hero-slide');
    const intervalTime = 5000;
    let currentSlide = 0;

    if (slides.length > 0) {
        setInterval(() => {
            slides[currentSlide].classList.remove('opacity-100');
            slides[currentSlide].classList.add('opacity-0');
            currentSlide = (currentSlide + 1) % slides.length;
            slides[currentSlide].classList.remove('opacity-0');
            slides[currentSlide].classList.add('opacity-100');
        }, intervalTime);
    }
</script>

<style>
    @keyframes fadeInUp {
        from { opacity: 0; transform: translateY(20px); }
        to { opacity: 1; transform: translateY(0); }
    }
    .animate-fade-in-up {
        animation: fadeInUp 0.8s ease-out forwards;
        opacity: 0;
    }
    .delay-100 { animation-delay: 0.1s; }
    .delay-200 { animation-delay: 0.2s; }
    .delay-300 { animation-delay: 0.3s; }
    .delay-500 { animation-delay: 0.5s; }
</style>