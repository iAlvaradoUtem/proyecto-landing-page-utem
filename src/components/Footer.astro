---
// Datos de Autoridades
const team = [
    { 
        name: "Mg. Patricia Mellado Acevedo", 
        role: "Jefa de Carrera Ingeniería en Informática",
        image: "/jefa-carrera.jpg" 
    },
    { 
        name: "Dr. Víctor Escobar Jeria", 
        role: "Director Escuela de Informática",
        image: "/director-escuela.jpg" 
    },
    { 
        name: "Secretaría de Escuela", 
        role: "Atención Alumnos",
        image: "/secretaria.jpg" 
    },
];

// Datos mios
const developer = {
    name: "Ignacio Alvarado Toledo",
    role: "Estudiante de Ingeniería en Informática",
    image: "/mi-foto.jpg", // Tu foto renombrada
    tags: ["Full Stack Developer", "UI/UX Designer", "Frontend Architecture"]
};

// Datos profesor
const professor = {
    name: "Sebastián Salazar Molina",
    role: "Profesor Asignatura",
    course: "EFE: Computación Móvil (EFE68500)",
    image: "/profe-sebasalazar.jpg"
};
---

<!-- SECCIÓN AUTORIDADES -->
<section id="about" class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-start">
            
            <!-- Columna Equipo Académico -->
            <div>
                <span class="text-utem-green font-bold uppercase tracking-widest text-sm">Equipo Académico</span>
                <h2 class="text-3xl font-serif font-bold text-utem-blue mb-6">Liderazgo Académico</h2>
                <p class="text-slate-600 mb-8 text-lg leading-relaxed">
                    La Escuela de Informática cuenta con un cuerpo docente de postgrado comprometido con la innovación tecnológica y la formación integral de los estudiantes.
                </p>
                
                <div class="grid gap-6">
                    {team.map(member => (
                        <div class="flex items-center gap-4 p-4 border border-slate-100 rounded-lg hover:border-utem-green/30 hover:bg-slate-50 transition-colors group">
                            <div class="w-14 h-14 rounded-full overflow-hidden border-2 border-utem-blue/10 flex-shrink-0 shadow-sm relative">
                                <img 
                                    src={member.image} 
                                    alt={member.name} 
                                    class="w-full h-full object-cover transform group-hover:scale-110 transition-transform duration-500 ease-out"
                                />
                            </div>
                            <div>
                                <h4 class="font-bold text-slate-800 text-sm group-hover:text-utem-blue transition-colors">{member.name}</h4>
                                <p class="text-xs text-utem-green font-medium uppercase">{member.role}</p>
                            </div>
                        </div>
                    ))}
                </div>
            </div>
            
            <!-- Columna Contacto -->
            <div id="contact" class="bg-utem-blue p-8 md:p-10 text-white rounded-sm shadow-2xl relative overflow-hidden transform hover:scale-105 transition-all duration-500 ease-out cursor-default">
                <div class="absolute top-0 right-0 -mr-10 -mt-10 w-40 h-40 bg-utem-green/30 rounded-full blur-2xl"></div>
                <div class="absolute bottom-0 left-0 -ml-10 -mb-10 w-40 h-40 bg-purple-500/20 rounded-full blur-2xl"></div>

                <h3 class="text-2xl font-serif font-bold mb-8 relative z-10">Contacto Admisión</h3>
                
                <ul class="space-y-6 relative z-10 text-sm md:text-base">
                    <li class="flex items-start gap-4">
                        <div class="mt-1 w-8 h-8 bg-white/10 rounded-full flex items-center justify-center flex-shrink-0">
                            <svg class="w-4 h-4 text-utem-green" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
                        </div>
                        <div>
                            <span class="block font-bold text-slate-200 text-xs uppercase mb-1">Call Center</span>
                            <a href="tel:+56223880976" class="hover:text-utem-green transition-colors text-lg font-bold">(+562) 2388 0976</a>
                        </div>
                    </li>
                    <li class="flex items-start gap-4">
                        <div class="mt-1 w-8 h-8 bg-white/10 rounded-full flex items-center justify-center flex-shrink-0">
                            <svg class="w-4 h-4 text-utem-green" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path></svg>
                        </div>
                        <div>
                            <span class="block font-bold text-slate-200 text-xs uppercase mb-1">WhatsApp Admisión</span>
                            <a href="https://wa.me/56992231814" target="_blank" class="hover:text-utem-green transition-colors font-medium">(+569) 9223 1814</a>
                        </div>
                    </li>
                    <li class="flex items-start gap-4">
                        <div class="mt-1 w-8 h-8 bg-white/10 rounded-full flex items-center justify-center flex-shrink-0">
                            <svg class="w-4 h-4 text-utem-green" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
                        </div>
                        <div>
                            <span class="block font-bold text-slate-200 text-xs uppercase mb-1">Correo Electrónico</span>
                            <a href="mailto:Postulantes@utem.cl" class="hover:text-utem-green transition-colors border-b border-white/20 pb-0.5">Postulantes@utem.cl</a>
                        </div>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</section>

<!-- SECCIÓN CREDITOS - MIOS Y PROFESOR -->
<section class="bg-slate-900 border-t border-slate-800 py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <div class="text-center mb-10">
            <span class="text-utem-green text-xs font-bold uppercase tracking-widest">Créditos del Proyecto</span>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-12 max-w-4xl mx-auto">
            
            <!-- TARJETA MIA -->
            <div class="flex flex-col items-center text-center group cursor-default">
                <div class="w-28 h-28 rounded-full overflow-hidden border-4 border-slate-800 group-hover:border-utem-green transition-colors duration-300 shadow-xl mb-4 relative">
                    <img 
                        src={developer.image} 
                        alt={developer.name} 
                        class="w-full h-full object-cover transform group-hover:scale-110 transition-transform duration-500 ease-out grayscale group-hover:grayscale-0"
                    />
                </div>
                <h4 class="text-white font-serif font-bold text-xl mb-1">{developer.name}</h4>
                <p class="text-slate-400 text-sm mb-4">{developer.role}</p>
                <div class="flex justify-center gap-2 flex-wrap mb-4 md:mb-0">
                    {developer.tags.map(tag => (
                        <span class="px-3 py-1 bg-slate-800 text-[10px] text-utem-green rounded-full border border-slate-700 uppercase tracking-wide">
                            {tag}
                        </span>
                    ))}
                </div>
            </div>

            <!-- TARJETA PROFESOR -->
            <div class="flex flex-col items-center text-center group cursor-default">
                <div class="w-28 h-28 rounded-full overflow-hidden border-4 border-slate-800 group-hover:border-utem-blue transition-colors duration-300 shadow-xl mb-4 relative">
                    <img 
                        src={professor.image} 
                        alt={professor.name} 
                        class="w-full h-full object-cover transform group-hover:scale-110 transition-transform duration-500 ease-out grayscale group-hover:grayscale-0"
                    />
                </div>
                <h4 class="text-white font-serif font-bold text-xl mb-1">{professor.name}</h4>
                <p class="text-slate-400 text-sm mb-1">{professor.role}</p>
                <p class="text-utem-green text-xs font-bold uppercase tracking-widest border border-slate-700 bg-slate-800 px-3 py-1 rounded-full">
                    {professor.course}
                </p>
            </div>

        </div>
    </div>
</section>

<!-- Footer Final -->
<footer class="bg-slate-950 text-slate-400 py-12 border-t border-slate-800 text-sm">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex flex-col md:flex-row justify-between items-center gap-8">
            <div class="flex items-center gap-4">
                <img 
                    src="/logo.png" 
                    alt="Escudo UTEM" 
                    class="h-12 w-auto object-contain opacity-90 hover:opacity-100 transition-opacity" 
                />
                <div class="flex flex-col border-l border-slate-700 pl-4">
                    <span class="text-white font-bold tracking-wide text-base">UTEM</span>
                    <span class="text-[10px] uppercase text-slate-500 tracking-wider">Universidad Tecnológica Metropolitana</span>
                </div>
            </div>
            
            <div class="flex gap-6 items-center">
                <a href="https://www.instagram.com/utem.cl/" target="_blank" class="group flex items-center gap-2 text-slate-500 hover:text-white transition-colors">
                    <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
                    <span class="hidden md:inline text-xs">Instagram</span>
                </a>
                <a href="https://twitter.com/utem" target="_blank" class="group flex items-center gap-2 text-slate-500 hover:text-white transition-colors">
                    <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
                    <span class="hidden md:inline text-xs">X</span>
                </a>
                <a href="https://www.facebook.com/utem.cl" target="_blank" class="group flex items-center gap-2 text-slate-500 hover:text-white transition-colors">
                    <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24"><path d="M9.101 23.691v-7.98H6.627v-3.667h2.474v-1.58c0-4.085 1.848-5.978 5.858-5.978.401 0 .955.042 1.468.103a8.68 8.68 0 0 1 1.141.195v3.325a8.623 8.623 0 0 0-.653-.036c-2.148 0-2.971.956-2.971 3.005v.97h4.438l-.602 3.667h-3.836v7.98h-4.968Z"/></svg>
                    <span class="hidden md:inline text-xs">Facebook</span>
                </a>
            </div>
        </div>
        <div class="mt-8 text-center md:text-left border-t border-slate-900 pt-8 text-xs text-slate-600">
            <p>&copy; 2025 Escuela de Informática UTEM. Proyecto académico.</p>
            <p>Desarrollado con Astro & Tailwind. -PROJECT LANDING PAGE-</p>
        </div>
    </div>
</footer>