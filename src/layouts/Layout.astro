---
interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="es" class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="Ingeniería Civil en Informática - UTEM" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>{title}</title>
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600&family=Merriweather:ital,wght@0,300;0,400;0,700;0,900;1,300;1,400&display=swap" rel="stylesheet">
	</head>

	<body class="bg-white text-slate-800 font-sans antialiased">
		
		<!-- PANTALLA DE CARGA -->
		<div id="intro-overlay" class="fixed inset-0 z-[100] flex flex-col items-center justify-center bg-utem-blue text-white transition-opacity duration-700 ease-out">
			
            <div class="flex flex-col items-center justify-center animate-pulse px-4 w-full max-w-4xl">
				
				<!-- Logo -->
				<img 
					src="/logo-completo.png" 
					alt="Universidad Tecnológica Metropolitana" 
					class="w-full max-w-[300px] md:max-w-[600px] h-auto object-contain mb-6"
				/>
				
				<!-- LINEA SEPARADORA -->
				<div class="w-full max-w-[300px] md:max-w-[600px] h-[1px] md:h-[2px] bg-utem-green mb-4 opacity-80"></div>

				<!-- TEXTO CARRERA -->
				<h2 class="text-lg md:text-2xl font-serif font-light tracking-widest text-center text-slate-200 mt-2">
					Ingeniería en Informática
				</h2>

			</div>
		</div>

		<slot />
		
	</body>
</html>

<script>
	window.addEventListener('DOMContentLoaded', () => {
		const overlay = document.getElementById('intro-overlay');
		if (overlay) {
			setTimeout(() => {
				overlay.classList.add('opacity-0');
				setTimeout(() => {
					overlay.style.display = 'none';
				}, 700);
			}, 2500); 
		}
	});
</script>
